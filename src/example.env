# Tokens
DISCORD_TOKEN=your-discord-bot-token
OWNER_IDS=your-user-id
PREFIX=x
MONGO=mongodb://your-mongodb-host:27017/your-database?retryWrites=true
MONGODB_URI=mongodb://your-mongodb-host:27017/your-database?retryWrites=true
API_NINJAS_KEY=your-api-ninjas-key
YOUTUBE_API_KEY=your-youtube-api-key

# Dashboard
SESSION_SECRET=your-secure-session-secret
CALLBACK_URL=http://localhost:3001/auth/callback
AUTH_COOKIE_NAME=discord_token

DASHBOARD_PORT=8080
DASHBOARD_DOMAIN=http://localhost
DASHBOARD_OWNER_IDS=your-user-id
LICENSE_KEY=your-license-key

# New web dashboard (dashboard/ — Svelte + Bun)
DASHBOARD_WEB_PORT=3000
DASHBOARD_WEB_URL=http://localhost:3000
BOT_API_URL=http://localhost:8080/api
BOT_INVITE_PERMISSIONS=8

DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret

# Ollama
OLLAMA_API_URL=https://your-ollama-host:port/api/generate
OLLAMA_DEFAULT_MODEL=tinyllama:1.1b
OLLAMA_SYSTEM_PROMPT=You are a helpful assistant in a Discord bot named Helix. Provide concise, accurate, and friendly answers.

# Runtime
NODE_ENV=development
PORT=3000
