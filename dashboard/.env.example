# Helix dashboard environment. Copy to .env and adjust.
# Bun auto-loads .env; the bot's src/.env is loaded automatically as fallback,
# so DISCORD_CLIENT_ID / DISCORD_CLIENT_SECRET / SESSION_SECRET only need to
# be set here if you want to override the bot's values.
# Precedence: real environment > dashboard/.env > src/.env > built-in defaults.

# Port the dashboard listens on
DASHBOARD_WEB_PORT=3000

# Public origin (dev). In production: https://dash.domain.tld
DASHBOARD_WEB_URL=http://localhost:3000

# Bot HTTP API base (prefix /api included)
BOT_API_URL=http://localhost:8080/api

# Same Discord app as the bot (Developer Portal → OAuth2). Optional if src/.env has them.
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=

# Secret for the session cookie (any long random string)
SESSION_SECRET=dev-dashboard-secret-change-me

# Permissions integer used for bot invite links (8 = Administrator)
BOT_INVITE_PERMISSIONS=8

# Discord user IDs with bot-developer dashboard tabs (Bot servers / Bot stats).
# Same value as the bot's OWNER_IDS; comma-separated if several.
# OWNER_IDS=

# NODE_ENV=production
