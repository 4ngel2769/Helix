{
	"name": "helix-dashboard",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "concurrently -k -n server,web \"bun run dev:server\" \"bun run dev:web\"",
		"dev:web": "vite",
		"dev:server": "bun --hot server/index.ts",
		"build": "vite build",
		"typecheck": "svelte-check --tsconfig ./tsconfig.json",
		"start": "bun server/index.ts"
	},
	"dependencies": {
		"@skyra/env-utilities": "^2.0.1",
		"jose": "^6.0.0",
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"@types/node": "^22.0.0",
		"bun-types": "^1.4.1",
		"concurrently": "^9.0.0",
		"svelte-check": "^4.0.0",
		"typescript": "^5.6.0",
		"vite": "^6.0.0"
	}
}
