{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"outDir": "dist-server",
		"rootDir": ".",
		"strict": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"types": ["node", "bun-types", "vite/client", "svelte"]
	},
	"include": ["server/**/*.ts", "src/**/*.ts", "vite.config.ts"]
}
